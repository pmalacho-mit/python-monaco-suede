{
	"name": "python-monaco-suede",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"dependencies": {
		"@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
		"@codingame/monaco-vscode-files-service-override": "~5.1.1",
		"@codingame/monaco-vscode-python-default-extension": "~5.1.1",
		"@typefox/pyright-browser": "^1.1.299",
		"jszip": "^3.10.1",
		"monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~5.1.1",
		"monaco-editor-wrapper": "~5.1.1",
		"monaco-languageclient": "~8.4.0",
		"vite-plugin-static-copy": "^3.1.0",
		"vscode": "npm:@codingame/monaco-vscode-api@~5.1.1",
		"vscode-languageclient": "~9.0.1",
		"vscode-languageserver-protocol": "^3.17.5",
		"y-monaco": "^0.1.6",
		"y-protocols": "^1.0.6"
	},
	"overrides": {
		"monaco-editor": "$monaco-editor",
		"vscode": "$vscode"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^25.0.10",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^4.0.15"
	}
}
