{
  "name": "python-monaco-suede",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:stop --silent && vite dev --host 0.0.0.0",
    "build": "./sweater-vest-suede/templates/sveltekit/with-exclude-tests-routes-from-build.sh vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "report": "./sweater-vest-suede/report.sh",
    "dev:stop": "pkill -f \"$PWD/node_modules/.bin/[v]ite\" || true"
  },
  "dependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@codingame/monaco-vscode-files-service-override": "~20.2.1",
    "@codingame/monaco-vscode-python-default-extension": "~20.2.1",
    "browser-basedpyright": "1.39.10",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~20.2.1",
    "monaco-editor-wrapper": "~6.12.0",
    "monaco-languageclient": "~9.11.0",
    "vite-plugin-static-copy": "^3.1.0",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@~20.2.1",
    "vscode-languageclient": "~9.0.1",
    "vscode-languageserver-protocol": "~3.17.5",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6"
  },
  "overrides": {
    "monaco-editor": "$monaco-editor",
    "vscode": "$vscode"
  },
  "devDependencies": {
    "@storybook/test": "^8.6.14",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.0.10",
    "dockerode": "^5.0.0",
    "dockview": "^4.11.0",
    "dockview-core": "^4.11.0",
    "html-to-image": "^1.11.13",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  }
}
